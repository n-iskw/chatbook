# terraform init -backend-config=backend.hcl で読み込む (ローカルから手動で prod へ apply する場合)。
# backend.hcl はコミットしない (gitignore 済み)。access_key/secret_key に
# Cloudflare R2 の API トークン (Access Key ID / Secret Access Key) を設定する。
# GitHub Actions からの apply は .github/workflows/terraform.yml が
# -backend-config の CLI 引数で同様の値を Secrets/Variables から渡す。

bucket                      = "<r2-bucket-name>"
key                         = "cognito/terraform.tfstate"
region                      = "auto"
access_key                  = "<r2-access-key-id>"
secret_key                  = "<r2-secret-access-key>"
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true

endpoints = {
  s3 = "https://<account-id>.r2.cloudflarestorage.com"
}
